# --- SaaS Platform & Security ---
DOCS_AUTH_USER=admin
DOCS_AUTH_PASS=
DOCS_AUTH_ENABLED=false
JWT_SECRET=apidocs_super_secret_session_key
STRIPE_WEBHOOK_SECRET=
