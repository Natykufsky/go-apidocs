# ==============================================================================
# go-apidocs Environment Configuration Template
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=8080
DOCS_TITLE="API Documentation & QA Hub"
DOCS_SUBTITLE="Developer Portal, Real-Time QA Suite & Sandbox"
DOCS_SPEC_PATH="./docs/swagger.json"
DOCS_README_PATH="./README.md"
DOCS_DIR="./docs"
DOCS_STORAGE_ROOT="./apidocs-data"
DOCS_QA_STORAGE="./docs/qa_tracker.json"

# ------------------------------------------------------------------------------
# 2. Authentication & Security Gate
# ------------------------------------------------------------------------------
# Set to 'true' to require login authentication for the portal
DOCS_AUTH_ENABLED=false

# Plain text credentials (optional, for rapid local development)
DOCS_AUTH_USER="admin"
DOCS_AUTH_PASS="admin123"

# Bcrypt hashed password (recommended for production, overrides plain DOCS_AUTH_PASS)
# Example hash for 'admin123':
# DOCS_AUTH_PASS_HASH="$2a$10$7v59QY.V7P0n298d0nC1e.4mKzBfG98t7f4r2.n1G7Q3g768j9K4W"

# HMAC cryptographic secret key for signing session tokens and invitations
DOCS_JWT_SECRET="apidocs_super_secret_production_key_change_me"

# ------------------------------------------------------------------------------
# 3. OAuth 2.0 Single Sign-On (GitHub & Google)
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 4. Feature Gates & Production Hardening
# ------------------------------------------------------------------------------
# Enable multi-workspace switcher and catalogs
ENABLE_WORKSPACES=true

# Enable importing/uploading OpenAPI JSON or YAML specs
ENABLE_WORKSPACE_WRITES=true

# Enable in-browser live OpenAPI spec editing and automated history backups
ENABLE_LIVE_SPEC_EDITING=true

# Enable cybersecurity static and live header vulnerability auditing
ENABLE_SECURITY_AUDIT=true

# ------------------------------------------------------------------------------
# 4. AI Test Generation & LLM Dispatcher (DeepSeek, NVIDIA NIM, OpenAI, Anthropic)
# ------------------------------------------------------------------------------
DEFAULT_AI_PROVIDER="nvidia"

# NVIDIA NIM (DeepSeek-V4.1 / DeepSeek-R1)
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="deepseek-ai/deepseek-v4.1-flash"

# DeepSeek Direct (Native API)
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-flash"

# Google Gemini (Google AI Studio)
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GEMINI_MODEL="gemini-3.8-flash"

# Groq Cloud
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-120b"

# OpenAI (Optional fallback)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Anthropic (Optional fallback)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Local Ollama (Optional offline fallback)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:latest"

# ------------------------------------------------------------------------------
# 5. SaaS Multi-Tenancy & Stripe Billing (Optional)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""
